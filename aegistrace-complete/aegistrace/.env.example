# Canonical application template: copy to .env only for a new checkout; never commit .env.
# Generate independent private tokens with a password manager or secure random generator.
# Values marked "native only" apply to direct uvicorn runs; Compose sets container values explicitly.
# Required private bearer token shared only by agent and the write-only audit sink; generate a new value.
AUDIT_WRITE_TOKEN=
# Required separate private bearer token for audit-to-anchor writes; generate independently.
ANCHOR_WRITE_TOKEN=
# Anchor every N events per session; 0 disables anchoring and weakens tamper detection.
ANCHOR_EVERY=10
# Live inference provider: groq, ollama, or local (Ollama alias).
LLM_PROVIDER=groq
# Private Groq credential; never expose it in frontend code or commit it.
GROQ_API_KEY=
# Groq model identifier for live inference.
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama model identifier; provision the model separately.
OLLAMA_MODEL=llama3:8b
# Legacy native-only provider alias, used when LLM_PROVIDER is empty in a direct run.
AGENT_LLM_PROVIDER=
# Native only: Ollama URL for a direct agent run; Compose fixes http://ollama:11434.
OLLAMA_BASE_URL=http://ollama:11434
# Native only: agent ingest URL; Compose fixes http://audit_service:8001/ingest.
AUDIT_SINK_URL=http://audit_service:8001/ingest
# Native only: audit anchor URL; Compose fixes http://anchor_service:8003/anchor.
ANCHOR_SINK_URL=http://anchor_service:8003/anchor
# Native only: SQLite path; Compose fixes /data/audit.db. Never mount in the agent.
DB_PATH=/data/audit.db
# Native only: anchor directory; Compose fixes /anchor_data (read-only in reconstruction).
ANCHOR_DATA_DIR=/anchor_data
# Native only: reconstruction static directory; use frontend for direct runs from this folder.
FRONTEND_DIR=/app/frontend
# Maximum agent sessions retained in memory (Compose passes this to the agent).
AGENT_MAX_SESSIONS=256
# Native only: Compose pins false. Writable demos require the explicit compose.demo.yaml override.
DEMO_MODE=false
# Native only: Compose fixes the container proxy URLs; preserve the isolated proxy architecture.
HTTP_PROXY=http://groq_proxy:3128
# Native only: Compose fixes the container CONNECT proxy; not a browser setting.
HTTPS_PROXY=http://groq_proxy:3128
# Native only: Compose fixes the proxy bypass list for internal destinations.
NO_PROXY=audit_service,ollama,localhost,127.0.0.1

# Explicit comma-separated browser origins, without paths; blank denies cross-origin access.
# The gateway also uses this list to add CORS headers to its own 413/429 responses.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Base emitted by reconstruction's /config.js; blank uses same origin. Separate static hosts set their own config.js.
AEGIS_API_BASE=
# Host-side benchmark opt-in only; export explicitly when using disposable local evidence, never enable by default.
AEGIS_ALLOW_DESTRUCTIVE=0

# Host-side gateway port; internal service ports remain unexposed.
FRONTEND_PORT=3000
# Gateway host bind address. Keep loopback; 0.0.0.0 exposes the gateway to the network.
BIND_HOST=127.0.0.1
# Gateway limit for /chat and /demo/session per real client IP: requests per minute, plus a burst of 5.
# Exceeding it returns 429 JSON. Must be a positive integer.
LLM_RATE_LIMIT_PER_MINUTE=10
# Gateway request-body limit in bytes; larger requests get a 413 JSON response. Must be positive.
MAX_REQUEST_BODY_BYTES=131072
# Agent prompt/message limit in characters; longer prompts get a 422 JSON response and are not captured.
MAX_PROMPT_CHARS=4000
# Agent outbound LLM timeout in seconds; a timeout gets a 504 JSON response after the turn is recorded.
LLM_TIMEOUT_SECONDS=20
# Comma-separated CIDR ranges of TLS/reverse proxies trusted to supply X-Forwarded-For.
# Empty (default) disables real-IP handling. Only trust proxies you control: when this is set,
# clients can spoof their rate-limit identity if an untrusted source can reach the gateway directly.
TRUSTED_PROXY_CIDR=

# Optional isolation-test override: colon-separated Compose files relative to this folder.
COMPOSE_FILES=compose.yaml
# Optional browser-test prerequisite: absolute path to an installed Cytoscape JavaScript file.
CYTOSCAPE_JS=
# Internal fixed ports are 8000 (agent), 8001 (audit), 8002 (reconstruction), 8003 (anchor),
# 3128 (egress proxy), and 11434 (optional Ollama); these are not env-configurable yet.
